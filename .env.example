# ──────────────────────────────────────────────────────────────
# EduFlow CRM – environment variables
# Copy this file to  backend/.env  and  frontend/.env  (see README)
# ──────────────────────────────────────────────────────────────

# ========================= backend/.env =========================
NODE_ENV=development
PORT=5000

# Supabase PostgreSQL connection string
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Session pooler" or "Direct" URI. Example:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Set to "true" for Supabase / any managed Postgres that requires TLS.
DATABASE_SSL=true

# JWT – generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Used when "Remember me" is ticked on the login page
JWT_REMEMBER_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Credentials used ONLY by  npm run seed:admin  (never hardcode in code)
SEED_ADMIN_NAME=EduFlow Admin
SEED_ADMIN_EMAIL=admin@eduflow.app
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ========================= frontend/.env ========================
# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5000/api
